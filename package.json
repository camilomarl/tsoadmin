{
  "name": "tsoadmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "generate": "prisma generate && tsoa spec-and-routes",
    "dev": "npm run generate && tsx watch src/server.ts",
    "build": "npm run generate && tsc && node scripts/copy-spec.mjs",
    "typecheck": "npm run generate && tsc --noEmit",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:integration": "npm run generate && RUN_INTEGRATION=true vitest run tests/integration.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "audit:runtime": "npm audit --omit=dev"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/prisma": "5.0.4",
    "@prisma/client": "^6.19.0",
    "adminjs": "^7.8.17",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.0",
    "express": "^4.21.2",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "pg": "^8.16.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.0"
  }
}
