DATABASE_URL=postgresql://tsoadmin:tsoadmin@localhost:5433/tsoadmin
TEST_DATABASE_URL=postgresql://tsoadmin:tsoadmin@localhost:5433/tsoadmin_test
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=false

LOG_LEVEL=info
SERVICE_NAME=tsoadmin
# Optional Datadog unified service tags:
# DD_ENV=development
# DD_VERSION=0.1.0

# Browser origin used for admin CSRF checks; use your HTTPS domain in production.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Additional browser origins permitted for the API, separated by commas.
CORS_ORIGINS=
API_RATE_LIMIT=100
ADMIN_LOGIN_RATE_LIMIT=20
